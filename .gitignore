# alat lokal
.claude/
node_modules/
*.log
.DS_Store
Thumbs.db

# database lokal yang tidak boleh online (data pelanggan & cadangan)
data/private/
data/history/
.wrangler/

# model referensi pihak ketiga (FurniMesh) — lisensi belum jelas, hanya lokal
data/source/furnimesh/

# 3D AI: foto upload, GLB mentah fal.ai & status pekerjaan — lokal saja
data/source/ai3d/
tools/icons/last-build.log

# hasil render foto Blender (tools/render) — besar & bisa dibuat ulang
output/

# GLB mentah hasil SKP (besar, bisa dibuat ulang) — yang online hanya hasil rapi di assets/items/
data/source/skp-glb/*/

# aset material untuk direview (katalog & unduhan mentah) — lokal saja; yang di-Acc masuk assets/library/textures/
data/source/staging/
data/source/glb-orig/
data/source/glb-pregrain/
data/source/glb-prebedding/

# foto referensi xionco.shop per produk (tools/shop-images.js) — besar, lokal saja
data/source/shop-img/

# pustaka aset render Galeri (Poly Haven CC0, tools/fetch-polyhaven.py) — besar, bisa diunduh ulang
data/source/render-lib/

# Galeri: frame referensi dari video pihak lain (pratinjau layout) — hanya lokal, JANGAN online
assets/galeri/ref/

# Z4: audit tangkapan layar & salinan model sebelum dihaluskan (lokal)
data/source/audit/
data/source/glb-presmooth/

# add-on Blender (SketchUp Importer, unduhan lokal)
data/source/addons/

# cache Python
__pycache__/

# salinan versi lama untuk dilihat (Developer Settings > Versi git) - lokal saja, tidak ikut online
v5-b/
v5-b.tmp-*/
